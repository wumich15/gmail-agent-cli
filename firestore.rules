rules_version = '2';

// The gateway is the only thing that may read or write this database, and it
// does so through the Admin SDK, which bypasses these rules by design.
//
// So this file exists to make the *absence* of any other access explicit and
// enforced: no signed-in user, no web page, and no mobile client can read
// another person's consent receipt or usage counters, or tamper with their
// own. Denying everything is not a placeholder here, it is the policy. If a
// future feature needs client reads, it gets a new collection with its own
// rule, rather than an exception widened onto these.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
