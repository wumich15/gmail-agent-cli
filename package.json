{
  "name": "gmail-agent-cli",
  "version": "0.1.0",
  "description": "Local terminal agent that cleans up Gmail inbox and creates Calendar events from actionable mail.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gmail": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "verify:package": "node scripts/verify-release-artifact.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:gpt": "pnpm build && node scripts/smoke-gpt.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval": "tsx evals/run.ts",
    "prepublishOnly": "pnpm build && pnpm verify:package"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "better-sqlite3": "^11.10.0",
    "commander": "^12.1.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "luxon": "^3.5.0",
    "openai": "^4.77.0",
    "picocolors": "^1.1.1",
    "pino": "^9.6.0",
    "undici": "^8.10.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
